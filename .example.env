# API runtime configuration.
# Copy this file to .env on each API environment. GitHub Actions does not
# upload or manage this file.

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
APP_KEY=change-this-local-secret
APP_CORS_ORIGIN=http://localhost:8080,http://localhost:5173
APP_RELEASE=local

# Logging and monitoring
# Leave LOG_DIR empty locally to use storage/logs. Use a private absolute path
# outside public/public_html on hosted environments.
LOG_DIR=
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=730
SLOW_REQUEST_MS=2000

# Sentry is optional. SENTRY_ENVIRONMENT defaults to APP_ENV when empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=biuro_zawodow
DB_USERNAME=biuro_user
DB_PASSWORD=biuro_pass

# Central Mailer
CENTRAL_MAILER_URL=http://localhost:8080
CENTRAL_MAILER_API_KEY=
CENTRAL_MAILER_TIMEOUT_SECONDS=120
CENTRAL_MAILER_BATCH_SIZE=50

# Platform integration (Zmierzymy Czas). Leave empty to keep the feature inactive.
# API base URL including /api/v1 (https only; http allowed in local/dev/test)
BZ_PLATFORM_API_URL=
# Application key sent as X-API-Key (same value as the biuro_zawodow=<secret> entry in the platform INCOMING_API_KEYS)
BZ_PLATFORM_APP_KEY=
# Key encrypting stored organization tokens: base64 of 32 random bytes.
# Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Losing this key makes stored tokens unreadable (they must be pasted again). Keep a copy in a password manager.
BZ_PLATFORM_TOKEN_KEY=
# Rotation only: set to the old key, run php scripts/reencrypt-platform-tokens.php --apply, then remove
BZ_PLATFORM_TOKEN_KEY_PREVIOUS=
# Optional request timeout, 1-30 seconds (default 10)
BZ_PLATFORM_TIMEOUT_SECONDS=10
