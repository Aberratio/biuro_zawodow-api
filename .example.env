# API runtime configuration.
# Copy this file to .env on each API environment. GitHub Actions does not
# upload or manage this file.

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
APP_KEY=change-this-local-secret
APP_CORS_ORIGIN=http://localhost:8080,http://localhost:5173
APP_RELEASE=local

# Logging and monitoring
# Leave LOG_DIR empty locally to use storage/logs. Use a private absolute path
# outside public/public_html on hosted environments.
LOG_DIR=
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=730
SLOW_REQUEST_MS=2000

# Sentry is optional. SENTRY_ENVIRONMENT defaults to APP_ENV when empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=biuro_zawodow
DB_USERNAME=biuro_user
DB_PASSWORD=biuro_pass

# Central Mailer
CENTRAL_MAILER_URL=http://localhost:8080
CENTRAL_MAILER_API_KEY=
CENTRAL_MAILER_TIMEOUT_SECONDS=10
CENTRAL_MAILER_BATCH_SIZE=500
