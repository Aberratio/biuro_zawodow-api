<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existing files and directories should bypass rewrites.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # API and documentation routes stay handled by PHP.
  RewriteCond %{REQUEST_URI} ^/(auth|bootstrap|docs|events|health|openapi\.json|organizations|participants|qr-images|superadmin|users)(/|$) [NC]
  RewriteRule ^ index.php [QSA,L]

  # Frontend routes handled by React Router must always resolve to index.html.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://zawodysportowe.online https://biuro-api.kokot.it http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
</IfModule>
